# Rendered user service template for the supervised agentmemory process owner.
# Replace @AGENTMEMORY_ROOT@, @AGENTMEMORY_BIN@, and @AGENTMEMORY_BIN_DIR@
# with `scripts/install-systemd.sh` before installing.
[Unit]
Description=agentmemory — persistent memory for AI coding agents (supervised)
After=network.target

[Service]
Type=simple
WorkingDirectory=@AGENTMEMORY_ROOT@
Environment=HOME=%h
Environment="PATH=@AGENTMEMORY_BIN_DIR@:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-%h/.agentmemory/.env
ExecStartPre=-/usr/bin/env "AGENTMEMORY_ROOT=@AGENTMEMORY_ROOT@" "AGENTMEMORY_BIN=@AGENTMEMORY_BIN@" /bin/bash "@AGENTMEMORY_ROOT@/scripts/am-daemon.sh" stop
ExecStart=/usr/bin/env "AGENTMEMORY_SUPERVISED=1" "AGENTMEMORY_III_CONFIG=@AGENTMEMORY_ROOT@/iii-config.supervised.yaml" "AGENTMEMORY_VERBOSE=1" "PATH=@AGENTMEMORY_BIN_DIR@:/usr/local/bin:/usr/bin:/bin" "@AGENTMEMORY_BIN@" --verbose
ExecStop=/usr/bin/env "AGENTMEMORY_ROOT=@AGENTMEMORY_ROOT@" "AGENTMEMORY_BIN=@AGENTMEMORY_BIN@" /bin/bash "@AGENTMEMORY_ROOT@/scripts/am-daemon.sh" stop
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
StandardOutput=append:%h/.agentmemory/logs/daemon.log
StandardError=append:%h/.agentmemory/logs/daemon.log

[Install]
WantedBy=default.target
